# ONEST Integration Configuration
# This file is a template for the environment variables required for REAL ONEST network integration.
# Do NOT commit the actual .env file with real keys.

# Mode: MOCK or REAL (Fallback is MOCK if not specified)
INTEGRATION_MODE=MOCK

# ONEST Network Configuration
ONEST_ENABLED=false
ONEST_BASE_URL=
ONEST_SUBSCRIBER_ID=
ONEST_SUBSCRIBER_URI=
ONEST_REGISTRY_URL=

# Beckn Configuration
BECKN_BAP_ID=
BECKN_BAP_URI=
BECKN_PRIVATE_KEY=
BECKN_PUBLIC_KEY=

# Security Config
# Generate a strong 256-bit secret key for JWT
JWT_SECRET=this-is-a-placeholder-secret-key-that-should-be-changed-in-production

# Database Configuration (Optional, defaults to application.properties)
# DB_URL=jdbc:mysql://localhost:3306/skill_verification
# DB_USERNAME=root
# DB_PASSWORD=root
