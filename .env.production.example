# ==============================================================
# Production Environment Configuration Template
# Rename this file to .env before running docker-compose up
# ==============================================================

# Database Configuration
DB_NAME=skill_verification
DB_PASSWORD=YourStrongProductionRootPassword123!

# Security Secret (At least 256-bit / 32 characters)
JWT_SECRET=c2VjdXJlLXByb2R1Y3Rpb24tc2VjcmV0LWtleS1mb3ItYmVja24tc2tpbGwtdmVyaWZpY2F0aW9uLW5ldHdvcms=

# ONEST / Beckn Network Identity (Set to your registered network subscriber ID)
ONEST_SUBSCRIBER_ID=skill-verification-bap.onest.network
ONEST_BASE_URL=https://your-domain.com/api/bpp
ONEST_SUBSCRIBER_URI=https://your-domain.com/api/beckn

# Beckn Gateway & Domain
BECKN_DOMAIN=onest:work-opportunities
BECKN_GATEWAY_URL=https://gateway.onest.network
BECKN_BAP_ID=skill-verification-bap.onest.network
BECKN_BAP_URI=https://your-domain.com/api/beckn
BECKN_KEY_ID=key-1

# Optional: Pre-generated RFC 8032 Ed25519 Keys (Base64)
# BECKN_PRIVATE_KEY=
# BECKN_PUBLIC_KEY=

